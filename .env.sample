# AgentMem server URL
AMS_URL=http://localhost:8080
AMS_TIMEOUT=120.0

# OpenAI API key — used by the TravelHub chat endpoint
# OPENAI_API_KEY — set via shell export in ~/.zshrc
# OPENAI_API_KEY=

# ============================================================
# OIDC / Auth testing (SEC-09 to SEC-14)
# ============================================================
# Mirror the AMS OIDC_AUTH_ENABLED setting.
# Set to true only when AMS is running with OIDC enabled.
OIDC_AUTH_ENABLED=false

# Bearer token for authenticated requests (only needed when OIDC_AUTH_ENABLED=true).
# Get via: curl -X POST http://<keycloak>/realms/agentmem/protocol/openid-connect/token \
#   -d "grant_type=client_credentials&client_id=agentmem-client&client_secret=<secret>"
# AMS_TOKEN=eyJhbGciOiJSUzxxxx...

# Expired token for SEC-14 (expired JWT test).
# Set Keycloak token TTL to 1 min, get a token, wait 65s, then paste here.
# AMS_EXPIRED_TOKEN=

# ============================================================
# mTLS testing (SEC-15)
# ============================================================
# Set to true only when AMS is configured with AGENTMEM_CONN_CLIENT_CERT/KEY
# and connected via couchbases://
AMS_MTLS_ENABLED=false
