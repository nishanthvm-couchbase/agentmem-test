FROM python:3.12-slim

WORKDIR /app

# Install SDK from sibling directory (build context = repo root)
COPY agentmem-sdk/ /sdk/
RUN pip install --no-cache-dir /sdk/

# Install test framework dependencies (skip the local SDK line)
COPY test/requirements.txt .
RUN grep -v "^agentmem" requirements.txt | pip install --no-cache-dir -r /dev/stdin

# Copy test framework source
COPY test/ .

EXPOSE 8000
CMD ["uvicorn", "main:app", "--host", "0.0.0.0", "--port", "8000"]
